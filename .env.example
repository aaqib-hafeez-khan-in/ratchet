# ---------------------------------------------------------------- required
# Postgres connection string for the control plane and worker.
DATABASE_URL=postgres://ratchet:ratchet@127.0.0.1:5433/ratchet
# 32+ random chars. Derives the API-key pepper and console session ids.
# Rotating this invalidates all API keys and console sessions.
AUTH_SECRET=dev-only-insecure-auth-secret-change-me

# ---------------------------------------------------------------- optional
NODE_ENV=development
PORT=8787
HOST=0.0.0.0
PUBLIC_URL=http://localhost:8787
DB_POOL_MAX=10
DB_SSL=false

# Comma-separated browser origins allowed to call the API with credentials.
# Leave empty for same-origin only (the default, and correct for production).
CORS_ORIGINS=

# Limit for UNAUTHENTICATED requests only (signup, health, docs), keyed by IP.
# Authenticated requests are limited by their workspace's plan — see plans.ts.
RATE_LIMIT_PER_MINUTE=600
MAX_REQUEST_BYTES=65536
MAX_RESULT_BYTES=32768

# ------------------------------------------------------------- webhooks
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=6
WEBHOOK_MAX_RESPONSE_BYTES=16384
# Optional hard allowlist of destination host suffixes, e.g. hooks.example.com
WEBHOOK_HOST_ALLOWLIST=
# MUST stay false outside of tests. Enables delivery to private/loopback IPs.
WEBHOOK_ALLOW_PRIVATE_NETWORK=false

# ------------------------------------------------------------- worker
LEASE_SWEEP_INTERVAL_MS=2000
WEBHOOK_POLL_INTERVAL_MS=1000
GC_INTERVAL_MS=300000

# How often the worker asks the primary how its standbys are doing.
REPLICATION_CHECK_INTERVAL_MS=60000
# Byte distance at which a standby is reported. Deliberately far below the
# cluster's max_slot_wal_keep_size (2 GB), past which the replication slot is
# invalidated and the node can only be rebuilt.
REPLICA_LAG_ALERT_BYTES=268435456
# How many standbys should be connected. 0 disables the check — an operator who
# has not said what to expect should not be told one is missing.
EXPECTED_REPLICAS=0

# ------------------------------------------------------------- billing
# 'test' uses the built-in test adapter (no network, no real charges).
# 'stripe' requires the two keys below and a configured webhook endpoint.
BILLING_PROVIDER=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Collect sales tax / VAT on credit purchases via Stripe Tax. Leave false until
# an origin address and tax registrations are configured in the Stripe
# dashboard — enabling it before that makes Stripe reject every checkout.
# Tax is charged on top of the pack price; credit granted is always face value.
STRIPE_AUTOMATIC_TAX=false

# ------------------------------------------------------------- crypto
# Non-custodial. Ratchet holds no key and takes custody of nothing: payments go
# directly to an address YOU control, and Ratchet only watches the chain.
# With either of these unset, crypto payments are off.
# Each address must be one YOU control. Ratchet only reads these chains.
# A chain with no destination set is simply off.
#
# Solana carries a memo on the transfer, so payments are detected and credited
# automatically. Ethereum, Base, and Bitcoin have no memo, so the payer submits
# the transaction hash and Ratchet verifies it on-chain.
SOLANA_DESTINATION_ADDRESS=
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
ETHEREUM_DESTINATION_ADDRESS=
ETHEREUM_RPC_URL=https://ethereum.publicnode.com
BASE_DESTINATION_ADDRESS=
BASE_RPC_URL=https://base-rpc.publicnode.com
BITCOIN_DESTINATION_ADDRESS=
BITCOIN_API_URL=https://mempool.space/api
CRYPTO_POLL_INTERVAL_MS=20000

# Volatile assets (ETH, BTC) need at least TWO independent price sources that
# agree. One source is a rumour, not a price. If they diverge by more than the
# tolerance below, quoting is refused rather than guessed.
CRYPTO_PRICE_SOURCES=coinbase,kraken
CRYPTO_MAX_PRICE_DIVERGENCE_BPS=200

# ------------------------------------------------------- transactional email
# 'log' writes each message to stdout and delivers nothing, so the whole queue,
# retry, and digest path runs without credentials. Set a provider to deliver.
# Supported: log | resend | postmark
EMAIL_PROVIDER=log
EMAIL_API_KEY=
EMAIL_FROM=Ratchet <alerts@your-domain.example>
EMAIL_REPLY_TO=
EMAIL_MAX_ATTEMPTS=5
EMAIL_POLL_INTERVAL_MS=5000

CONSOLE_SESSION_TTL_HOURS=72

# --- x402 machine payments (optional; OFF unless both of the first two are set)
# Lets an agent that has exhausted its anonymous quota pay to continue, with no
# account. Settling an EIP-3009 authorization requires submitting a transaction,
# which needs a funded wallet — this service does not hold one, so settlement is
# delegated to a facilitator. Without one configured, x402 stays off rather than
# advertising a price we cannot collect.
X402_FACILITATOR_URL=
X402_FACILITATOR_KEY=
X402_PAY_TO=
X402_NETWORK=eip155:8453
X402_ASSET=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
X402_AMOUNT=1000000
X402_CREDIT_MICROS=1000000

# Bearer token for GET /metrics (Prometheus text format). Unset means the
# endpoint does not exist and returns 404 — it is not merely unauthenticated.
# Must be at least 16 characters; production refuses to start with a shorter
# one, because a token too weak to guard the endpoint is worse than no endpoint.
METRICS_TOKEN=
