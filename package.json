{
  "name": "ratchet",
  "version": "0.2.1",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "description": "Ratchet \u2014 the effect gate for AI agents. At-most-once side effects, budget enforcement, and an auditable execution record.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/worker/main.ts",
    "dev:db": "bash scripts/dev-db.sh up",
    "dev:db:down": "bash scripts/dev-db.sh down",
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/migrations",
    "start": "node dist/api/server.js",
    "start:worker": "node dist/worker/main.js",
    "mcp:stdio": "tsx src/mcp/stdio.ts",
    "migrate": "tsx src/db/migrate.ts up",
    "seed": "tsx scripts/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "bash scripts/test.sh",
    "test:unit": "node --test --import tsx test/unit/*.test.ts",
    "test:integration": "node --test --test-concurrency=1 --import tsx test/integration/*.test.ts",
    "test:e2e": "node --test --test-concurrency=1 --import tsx test/e2e/*.test.ts",
    "openapi": "tsx scripts/emit-openapi.ts",
    "audit": "npm audit --omit=dev",
    "stripe:listen": "stripe listen --forward-to localhost:8787/v1/billing/webhook/stripe --events checkout.session.completed,customer.subscription.created,customer.subscription.updated,customer.subscription.deleted,charge.refunded,charge.dispute.created",
    "stripe:trigger": "stripe trigger checkout.session.completed",
    "stripe:check": "tsx scripts/check-stripe.ts",
    "metrics": "tsx scripts/metrics.ts",
    "deploy:preflight": "bash scripts/deploy-preflight.sh",
    "deploy:fly": "bash scripts/deploy-fly.sh",
    "pg:swap-unmanaged": "bash scripts/swap-to-unmanaged-pg.sh",
    "x402:check": "tsx scripts/x402-check.ts",
    "backup:verify": "bash scripts/backup-verify.sh",
    "stress": "tsx scripts/stress.ts",
    "probe:prod": "tsx scripts/prod-probe.ts",
    "snapshot:code": "bash scripts/snapshot-code.sh",
    "uptime": "node scripts/uptime-check.mjs",
    "encrypt:env": "bash scripts/encrypt-env.sh",
    "case-study": "tsx scripts/case-study.ts",
    "feedback": "tsx scripts/feedback.ts",
    "deploy:staging": "flyctl deploy --config fly.staging.toml --app ratchet-gate-staging --now --build-arg GIT_COMMIT=$(git rev-parse HEAD)",
    "deploy": "bash scripts/deploy.sh",
    "smoke:staging": "node scripts/smoke.mjs",
    "deploy:force": "flyctl deploy --now --build-arg GIT_COMMIT=$(git rev-parse HEAD)",
    "schema": "node scripts/build-schema.mjs",
    "schema:check": "node scripts/build-schema.mjs --check",
    "bench:ab": "tsx scripts/ab-benchmark.ts",
    "set-plan": "tsx scripts/set-plan.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/cors": "11.3.0",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@fastify/swagger": "9.8.1",
    "dotenv": "17.4.2",
    "fastify": "5.12.1",
    "fastify-plugin": "^5.1.0",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "tsx": "4.23.12",
    "typescript": "5.9.3"
  }
}
