# Encrypted secrets. This repository is public: an encrypted blob here is an
# offline brute-force target that never expires. Keep them in a password
# manager instead.
*.enc
*.age
env.enc
.claude/launch.json

# Python bytecode, from running the example locally
__pycache__/
*.pyc
